# =============================================================================
# infra/vlibras-dev/.env.example
# -----------------------------------------------------------------------------
# AMBIENTE NAO-PRODUCAO. Copie para `.env` e ajuste SOMENTE valores de DEV.
#
#   cp .env.example .env    (Linux/macOS)
#   Copy-Item .env.example .env   (Windows PowerShell)
#
# Todos os valores abaixo sao PLACEHOLDERS DE DESENVOLVIMENTO.
# NUNCA coloque credenciais reais de producao aqui (Requirements 8.2, 9.4, 17.1).
# Tokens de API de produto real devem ficar em um secret manager no backend,
# fora deste arquivo, do app e do manifesto (Requirement 17.1).
# =============================================================================

# --- Portas locais expostas no host ------------------------------------------
TRANSLATOR_API_PORT=5000
MONGO_PORT=27017
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# --- MongoDB (placeholders de DEV) -------------------------------------------
MONGO_USER=vlibras_dev
MONGO_PASSWORD=dev_placeholder_change_me

# --- Redis (placeholder de DEV) ----------------------------------------------
REDIS_PASSWORD=dev_placeholder_change_me

# --- RabbitMQ (placeholders de DEV) ------------------------------------------
RABBITMQ_USER=vlibras_dev
RABBITMQ_PASSWORD=dev_placeholder_change_me
